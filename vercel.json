{
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/portal", "destination": "/portal/dashboard.html" },
    { "source": "/portal/", "destination": "/portal/dashboard.html" },
    { "source": "/api/(.*)", "destination": "/api?__path=/api/$1" }
  ]
}
